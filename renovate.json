{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>dev-hato/renovate-config"],
  "ignoreDeps": ["node-fetch"],
  "packageRules": [
    {
      "description": "Use the FLATT registry for npm packages",
      "matchDatasources": ["npm"],
      "registryUrls": ["https://npm.flatt.tech/"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/ghalint\\.ya?ml$/"],
      "matchStrings": [
        "GHALINT_VERSION: (?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)\\s+GHALINT_SHA256: (?<currentDigest>[0-9a-f]{64})"
      ],
      "datasourceTemplate": "github-release-attachments",
      "depNameTemplate": "suzuki-shunsuke/ghalint",
      "versioningTemplate": "semver"
    }
  ]
}
